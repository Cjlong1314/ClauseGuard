# ---------- 数据库 ----------
# 宿主机直连数据库用（compose容器内由environment覆盖为db:5432）
DATABASE_URL=postgresql://clauseguard:Cg%402026pg@127.0.0.1:5432/clauseguard
POSTGRES_USER=clauseguard
POSTGRES_PASSWORD=Cg%402026pg
POSTGRES_DB=clauseguard
POSTGRES_PORT=5432

# ---------- 应用 ----------
APP_PORT=8600

# ---------- LLM本地模型服务 ----------
# 预置模型（二选一）：Ollama用qwen2.5:14b / qwen2.5:32b / deepseek-r1:14b；
# vLLM用Qwen/Qwen2.5-14B-Instruct-AWQ / Qwen/Qwen2.5-32B-Instruct-AWQ（GPTQ/AWQ量化见docs/模型选型与压测基线.md）
OLLAMA_RUNTIME=ollama            # vllm | ollama：决定启用哪个模型服务profile与LLM地址
LLM_MODEL_NAME=Qwen/Qwen2.5-14B-Instruct-AWQ   # vLLM模型名
LLM_MAX_CONCURRENCY=16           # vLLM continuous batching并发上限
LLM_GPU_MEM_UTIL=0.90
LLM_PORT=8000
OLLAMA_PORT=11434

# 应用侧LLM配置（容器内地址；宿主机裸跑时改127.0.0.1）
# ollama模式请设为 http://host.docker.internal:11434/v1 或改LLM_BASE_URL_CONTAINER
LLM_BASE_URL_CONTAINER=http://llm:8000/v1
LLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
LLM_API_KEY=                     # 本地模型一般留空
LLM_RUNTIME=                     # 留空自动推断；ollama|vllm|openai

# 可选第二模型交叉验证（防幻觉），留空则仅规则引擎复核
LLM_CROSS_BASE_URL=
LLM_CROSS_MODEL=

# ---------- Embedding ----------
# 本地bge-m3（Ollama或TEI/vLLM均可提供OpenAI兼容embedding）
EMBEDDING_BASE_URL_CONTAINER=http://llm:8000/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=
# 自测假向量模式，生产必须为空
EMBEDDING_FAKE=

# ---------- 备份 ----------
BACKUP_DIR=./backups             # 每日全量备份输出目录
BACKUP_KEEP_DAYS=14              # 备份保留天数（滚动清理）
